Track(RunService.Heartbeat:Connect(function()
    if not Active then return end
    local hum=GetHum() local char=GetChar() local root=GetRoot()

    if Config.Player.GodMode and hum then hum.Health=hum.MaxHealth end
    if hum then hum.WalkSpeed=Config.Player.SpeedEnabled and Config.Player.SpeedValue or 16 end

    if Config.Aimbot.NoRecoil then
        local tool=LP.Character and LP.Character:FindFirstChildOfClass("Tool")
        if tool then
            local gun=tool:FindFirstChildOfClass("LocalScript") or tool:FindFirstChildOfClass("Script")
            -- Hook recoil by locking camera pitch
            local cf=Cam.CFrame
            local _,y,_=cf:ToEulerAnglesYXZ()
            Cam.CFrame=CFrame.new(cf.Position)*CFrame.Angles(select(1,cf:ToEulerAnglesYXZ()),y,0)
        end
    end

    if Config.Player.NoClip and char then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end

    -- Skin Changer
    if Config.Skins.GunEnabled and char then
        local tool=char:FindFirstChildOfClass("Tool")
        if tool then
            for _,p in ipairs(tool:GetDescendants()) do
                if p:IsA("MeshPart") or p:IsA("SpecialMesh") or p:IsA("Part") then
                    pcall(function()
                        if p:IsA("SpecialMesh") then
                            p.TextureId=Config.Skins.GunSkin
                        else
                            local mesh=p:FindFirstChildOfClass("SpecialMesh")
                            if mesh then mesh.TextureId=Config.Skins.GunSkin end
                            local decal=p:FindFirstChildOfClass("Decal")
                            if decal then decal.Texture=Config.Skins.GunSkin end
                        end
                    end)
                end
            end
        end
    end

    if Config.Skins.KnifeEnabled and char then
        for _,tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("knife") or tool.Name:lower():find("blade") or tool.Name:lower():find("melee")) then
                for _,p in ipairs(tool:GetDescendants()) do
                    pcall(function()
                        if p:IsA("SpecialMesh") then
                            p.TextureId=Config.Skins.KnifeSkin
                        else
                            local mesh=p:FindFirstChildOfClass("SpecialMesh")
                            if mesh then mesh.TextureId=Config.Skins.KnifeSkin end
                            local decal=p:FindFirstChildOfClass("Decal")
                            if decal then decal.Texture=Config.Skins.KnifeSkin end
                        end
                    end)
                end
            end
        end
    end

end))

